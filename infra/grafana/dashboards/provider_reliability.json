      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (provider, from_state, to_state) (increase(tollgate_circuit_transitions_total[1h]))",
          "legendFormat": "{{provider}}: {{from_state}} → {{to_state}}",
          "refId": "A"
        }
      ],
      "title": "Circuit Transitions (Past 1h)",
      "type": "timeseries"
    }
