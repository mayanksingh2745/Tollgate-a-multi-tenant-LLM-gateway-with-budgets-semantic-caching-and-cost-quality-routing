{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://tollgate-gateway.onrender.com/api/:path*"
    },
    {
      "source": "/healthz",
      "destination": "https://tollgate-gateway.onrender.com/healthz"
    },
    {
      "source": "/readyz",
      "destination": "https://tollgate-gateway.onrender.com/readyz"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
