# Environment configuration for Tollgate LLM Gateway

ENVIRONMENT=development
LOG_LEVEL=INFO

# Gateway Server Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# PostgreSQL Database Configuration
POSTGRES_USER=tollgate
POSTGRES_PASSWORD=tollgate_secret_pass
POSTGRES_DB=tollgate_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://tollgate:tollgate_secret_pass@postgres:5432/tollgate_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Dashboard Configuration
VITE_API_BASE_URL=http://localhost:8000
