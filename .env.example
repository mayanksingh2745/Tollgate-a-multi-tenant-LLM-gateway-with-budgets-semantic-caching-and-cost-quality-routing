# ==============================================================================
# Tollgate LLM Gateway - Environment Configuration Template
# All secrets and credentials must be replaced before deploying to production.
# ==============================================================================

# Core Application Environment: 'development' or 'production'
ENVIRONMENT=production
LOG_LEVEL=INFO

# Gateway Server Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# CORS Configuration (comma-separated origins for production)
TOLLGATE_CORS_ALLOWED_ORIGINS=https://app.tollgate.ai,http://localhost:3000

# PostgreSQL Database Configuration
POSTGRES_USER=tollgate
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_DB=tollgate_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://tollgate:replace_with_strong_database_password@postgres:5432/tollgate_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Upstream LLM Provider Credentials
OPENAI_API_KEY=replace_with_openai_api_key
ANTHROPIC_API_KEY=replace_with_anthropic_api_key
GEMINI_API_KEY=replace_with_gemini_api_key
MOCK_PROVIDER_API_KEY=replace_with_mock_key

# Distributed Tracing (OpenTelemetry)
TOLLGATE_OTEL_ENABLED=true
TOLLGATE_OTEL_ENDPOINT=http://jaeger:4318
TOLLGATE_OTEL_SERVICE_NAME=tollgate-api
TOLLGATE_OTEL_TRACE_SAMPLE_RATE=1.0

# Prometheus Operational Metrics
TOLLGATE_METRICS_ENABLED=true
TOLLGATE_METRICS_AUTH_ENABLED=true
TOLLGATE_METRICS_TOKEN=replace_with_secure_metrics_bearer_token

# Rate Limiting & Circuit Breakers
TOLLGATE_RATE_LIMIT_ENABLED=true
TOLLGATE_CIRCUIT_BREAKER_ENABLED=true

# Dashboard Configuration
VITE_API_BASE_URL=https://api.tollgate.ai
